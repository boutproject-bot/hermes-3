#!/usr/bin/env python3

# Components and options that use structured (index-space) perpendicular
# operators, boundary loops, Laplacian inversions or Jacobian colouring
# must stop with a clear error on unstructured FCI grids instead of giving
# silently wrong results. Also checks that the base input runs and that an
# expression in the index coordinate x stops (and only warns with
# input:allow_index_coordinates = true).

import sys
from pathlib import Path

from boututils.run_wrapper import launch, shell

GUARD = "is not supported on unstructured FCI grids"
COLOURING = "Jacobian colouring is not supported on unstructured meshes"
INDEX_COORDINATE = "uses the index coordinate x or z on an unstructured mesh"
# Only in the error, not in the warning
INDEX_ERROR = "or set input:allow_index_coordinates = true"
WALL_NODES = "stores Dirichlet wall nodes in the x guard cells"

# (name, command-line options, expect failure, expected text)
CASES = [
    ("base input", "", False, None),
    ("index coordinate x", "'Nh+:function=1+0.1*x'", True, INDEX_ERROR),
    (
        "index coordinate x, allowed",
        "'Nh+:function=1+0.1*x' input:allow_index_coordinates=true",
        False,
        INDEX_COORDINATE,
    ),
    (
        "neutral_mixed",
        "hermes:components=h+,d d:type=neutral_mixed d:AA=2",
        True,
        GUARD,
    ),
    ("classical_diffusion", "hermes:components=h+,classical_diffusion", True, GUARD),
    ("vorticity", "hermes:components=h+,vorticity", True, GUARD),
    ("relax_potential", "hermes:components=h+,relax_potential", True, GUARD),
    ("electromagnetic", "hermes:components=h+,electromagnetic", True, GUARD),
    ("polarisation_drift", "hermes:components=h+,polarisation_drift", True, GUARD),
    ("diamagnetic_drift", "hermes:components=h+,diamagnetic_drift", True, GUARD),
    (
        "ion viscosity (perpendicular)",
        (
            "hermes:components=h+,braginskii_ion_viscosity "
            "braginskii_ion_viscosity:perpendicular=true"
        ),
        True,
        GUARD,
    ),
    (
        "SOL recycling",
        (
            "hermes:components=h+,recycling recycling:species=h+ "
            "h+:recycle_as=h+ h+:sol_recycle=true"
        ),
        True,
        GUARD,
    ),
    (
        "target recycling",
        (
            "hermes:components=h+,recycling recycling:species=h+ "
            "h+:recycle_as=h+ h+:target_recycle=true"
        ),
        True,
        GUARD,
    ),
    ("low_n_diffuse_perp", "h+:low_n_diffuse_perp=true", True, GUARD),
    ("hyper_z", "h+:hyper_z=0.1", True, GUARD),
    ("neumann_boundary_average_z", "Nh+:neumann_boundary_average_z=true", True, GUARD),
    (
        "evolve_pressure low_T_diffuse_perp",
        (
            "h+:type=evolve_density,evolve_pressure,anomalous_diffusion "
            "'Ph+:bndry_xin=dirichlet_node(1.0)' 'Ph+:bndry_xout=dirichlet_node(1.0)' "
            "h+:low_T_diffuse_perp=true"
        ),
        True,
        GUARD,
    ),
    (
        "evolve_momentum low_p_diffuse_perp",
        (
            "h+:type=fixed_density,evolve_momentum h+:density=1e18 "
            "'NVh+:bndry_xin=dirichlet_node(0.0)' 'NVh+:bndry_xout=dirichlet_node(0.0)' "
            "'Vh+:bndry_xin=dirichlet_node(0.0)' 'Vh+:bndry_xout=dirichlet_node(0.0)' "
            "h+:low_p_diffuse_perp=true"
        ),
        True,
        GUARD,
    ),
    ("ordinary x boundary at wall nodes", "Nh+:bndry_xin=neumann", True, WALL_NODES),
    (
        "Jacobian colouring (SNES backward Euler)",
        "solver:type=beuler solver:use_coloring=true",
        True,
        COLOURING,
    ),
]

failures = []
log = []
for name, options, expect_failure, text in CASES:
    shell("rm -f data/BOUT.dmp.*.nc")
    status, out = launch(f"../../../hermes-3 -q {options}", nproc=1, pipe=True)
    log.append(f"==== {name}: {options}\n{out}")
    ok = (status != 0) == expect_failure and (text is None or text in out)
    result = "stopped" if status != 0 else "ran"
    print(f"{name:50s} {result:8s} {'PASS' if ok else 'FAIL'}")
    if not ok:
        failures.append(name)

Path("run.log").write_text("\n".join(log))

if failures:
    print(" => Test failed:", ", ".join(failures))
    sys.exit(1)
print(" => Test passed")
sys.exit(0)
