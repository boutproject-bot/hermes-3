# Flux tubes that close on themselves, with a structured z: advection and
# sound waves along the magnetic field, without sources. ./runtest writes a
# structured field-aligned grid and the same cells as a list along x, and
# runs this input on both.

nout = 2
timestep = 2000

[tube]
s = gridvar:s_cell  # Angle along the flux tube, 0 to 2 pi
r = gridvar:r_cell  # Position across the flux tubes, 0 to 1

[solver]
type = pvode
mxstep = 100000
rtol = 1e-10
atol = 1e-12

[hermes]
components = h+, e, sound_speed
Nnorm = 1e19  # Reference density [m^-3]
Bnorm = 1     # Reference magnetic field [T]
Tnorm = 50    # Reference temperature [eV]

[sound_speed]
electron_dynamics = false

[h+]
type = evolve_density, evolve_momentum, evolve_pressure
AA = 1
charge = 1
thermal_conduction = false
p_div_v = true
diagnose = true

[e]
type = quasineutral, zero_current, evolve_pressure
AA = 1.0 / 1836.0
charge = -1
thermal_conduction = false
diagnose = true

[Nh+]
function = 1.0 + 0.3 * (1 + 0.5 * tube:r) * sin(tube:s + 2 * z) + 0.1 * cos(3 * tube:s - z)
bndry_all = neumann

[NVh+]
function = 0.2 * (1 + tube:r) * cos(tube:s - z)
bndry_all = neumann

[Ph+]
function = `Nh+`:function * (1 + 0.2 * sin(2 * tube:s))
bndry_all = neumann

[Pe]
function = `Nh+`:function * (1 - 0.1 * cos(tube:s))
bndry_all = neumann

[input]
# The functions above are in the standard frame (z is the toroidal angle)
# on both meshes; with ShiftedMetric they would otherwise be shifted from
# the field-aligned frame
transform_from_field_aligned = false

[input:grid_variables]
s_cell = field3d
r_cell = field3d
