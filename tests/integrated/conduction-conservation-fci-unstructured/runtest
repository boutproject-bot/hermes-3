#!/usr/bin/env python3

# Energy conservation of parallel heat conduction on an unstructured FCI grid.
#
# Closed field lines (sheared slab, no parallel boundaries) and genuine
# interpolation between independently stored planes. Electrons only, fixed
# density, pressure evolved by Braginskii conduction. The support-operator
# method (conduction_method = petscoperator, the default on unstructured
# grids) conserves the physical total sum(V * Pe) to solver precision, with
# V = A J dx dy dz and A the poloidal (dual-cell) area of each node
# (dagp_us_volume; dx = dz = 1 on unstructured grids). The drift of the
# original method is printed for comparison.
#
# The support-operator run sets no conduction_method, so it also checks that
# petscoperator is the default on unstructured grids (BOUT.settings). Note:
# petscoperator is conservative but converges only at order 0.7-1.4 in the
# solution on irregular meshes (MMS-spatial-fci-unstructured, solution-error
# check); original converges at order 2 but does not conserve exactly.

import sys
from pathlib import Path

from boutdata.collect import collect
from boututils.datafile import DataFile
from boututils.run_wrapper import launch_safe, shell
from numpy import abs, max, std, sum

gridfile = "../../../grids/fci_unstructured/US_closed/US_closed_16.fci.grid.nc"
with DataFile(gridfile) as grid:
    area = grid["dagp_us_volume"]

nproc = 1
results = {}
default_ok = False
for method in ("petscoperator", "original"):
    shell("rm -f data/BOUT.dmp.*.nc")
    # petscoperator is the default on unstructured grids: run it unset
    selection = "" if method == "petscoperator" else f"conduction_method={method} "
    args = f"{selection}mesh:file={gridfile}"
    print("Running with " + args)
    _, out = launch_safe("../../../hermes-3 " + args, nproc=nproc, pipe=True)
    Path(f"run.log.{method}").write_text(out)
    if method == "petscoperator":
        settings = Path("data/BOUT.settings").read_text()
        default_ok = any(
            line.startswith("conduction_method = petscoperator")
            and "source: default" in line
            for line in settings.splitlines()
        )

    mxg = int(collect("MXG", path="data", info=False))
    Pe = collect("Pe", path="data", info=False)[:, mxg:-mxg]
    dV = (
        collect("J", path="data", info=False)
        * collect("dx", path="data", info=False)
        * collect("dy", path="data", info=False)
        * collect("dz", path="data", info=False)
    )[mxg:-mxg] * area[mxg:-mxg]
    energy = sum(Pe * dV, axis=(1, 2, 3))
    drift = max(abs(energy - energy[0])) / energy[0]
    relaxed = std(Pe[-1]) / std(Pe[0])
    results[method] = (drift, relaxed)
    print(
        f"{method}: relative energy drift {drift:.3e}, profile std ratio {relaxed:.3f}"
    )

success = True
if not default_ok:
    print("petscoperator is not the default conduction_method on unstructured grids")
    success = False
drift, relaxed = results["petscoperator"]
if drift > 1e-8:
    print(f"petscoperator does not conserve energy (drift {drift:.3e} > 1e-8)")
    success = False
if relaxed > 0.9:
    print(f"Conduction did not act (profile std ratio {relaxed:.3f} > 0.9)")
    success = False
if results["original"][0] <= drift:
    print("Note: original conserves at least as well as petscoperator here")

if success:
    print(" => Test passed")
    sys.exit(0)
print(" => Test failed")
sys.exit(1)
