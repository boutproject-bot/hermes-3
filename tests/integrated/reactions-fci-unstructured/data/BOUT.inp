# Reaction rates averaged along the magnetic field on unstructured FCI
# meshes: ions, electrons and atoms with ionisation. ./runtest sets the mesh
# and the profiles; only the first evaluation (t = 0) is used.

nout = 1
timestep = 1e-3

[solver]
type = pvode
mxstep = 100000

[hermes]
components = h+, e, h, sound_speed, sheath_boundary_fci, reactions
Nnorm = 1e19  # Reference density [m^-3]
Bnorm = 1     # Reference magnetic field [T]
Tnorm = 10    # Reference temperature [eV]

[input:grid_variables]
Z = field3d

[profile]
# Variation across the field lines (0: uniform plasma and atoms)
amplitude = 1
# Field lines that move one node (1/8) in Z per plane (1) or straight (0)
tilt = 0
# Field-line label: Z at the first plane, y = 2 pi (j + 1/2) / 8 in plane j
label = gridvar:Z - tilt * (y - pi / 8) / (2 * pi)
wave = amplitude * sin(2 * pi * label)

[sound_speed]
electron_dynamics = false

[h+]
type = evolve_density, evolve_momentum, evolve_pressure
AA = 1
charge = 1
thermal_conduction = false

[Nh+]
function = 1 + 0.3 * profile:wave
bndry_all = neumann

[NVh+]
function = 0
bndry_all = neumann

[Ph+]
function = `Nh+`:function
bndry_all = neumann

[e]
type = quasineutral, zero_current, evolve_pressure
AA = 1 / 1836
charge = -1
thermal_conduction = false

[Pe]
# Te = 1 + 0.4 cos(2 pi label) in units of Tnorm
function = `Nh+`:function * (1 + 0.4 * profile:amplitude * cos(2 * pi * profile:label))
bndry_all = neumann

[h]
type = neutral_mixed
AA = 1
collisionality_override = 0.01

[Nh]
function = 0.1 * (1 - 0.5 * profile:wave)
bndry_all = neumann

[Ph]
function = 0.05 * `Nh`:function
bndry_all = neumann

[NVh]
function = 0
bndry_all = neumann

[reactions]
diagnose = true
type = (h + e -> h+ + 2e)
