#!/usr/bin/env python3

# Solver statistics of an unstructured FCI run against its structured
# counterpart.
#
# Runs ../2D-density-anomalous-fci (structured, 32 x 32) and its unstructured
# counterpart (US_slab_xz_32, input generated by unstructured_utils.py) with
# the same settings and compares the work of the PVODE solver (RHS
# evaluations; PVODE writes no step counts). Guards against changes that make
# unstructured runs much stiffer. The cost per RHS evaluation is printed but
# not checked (machine dependent).

import shutil
import sys
from pathlib import Path

from boutdata.collect import collect
from boututils.run_wrapper import launch_safe, shell

this_dir = Path(__file__).resolve().parent
sys.path.append(str(this_dir.parent))
from unstructured_utils import make_unstructured_input

make_unstructured_input(
    "2D-density-anomalous-fci",
    xu="gridvar:R - 1.5",
    zu="6.28318530717959*(gridvar:Z + 0.5)",
    here=this_dir,
)
structured = this_dir / "structured"
structured.mkdir(exist_ok=True)
shutil.copy(
    this_dir.parent / "2D-density-anomalous-fci" / "data" / "BOUT.inp", structured
)

nout = 20
timestep = 1e7 / nout
cases = {
    "structured": (
        "structured",
        "../../../grids/MMS_slab_xz/MMS_straight_slab_36_1_32_False.fci.grid.nc",
    ),
    "unstructured": (
        "data",
        "../../../grids/fci_unstructured/US_slab_xz/US_slab_xz_32.fci.grid.nc",
    ),
}

stats = {}
for name, (path, grid) in cases.items():
    shell(f"rm -f {path}/BOUT.dmp.*.nc")
    args = (
        f"-d {path} mesh:file={grid} nout={nout} timestep={timestep} solver:type=pvode"
    )
    print("Running with " + args)
    _, out = launch_safe("../../../hermes-3 " + args, nproc=1, pipe=True)
    Path(f"run.log.{name}").write_text(out)

    npoints = collect("Nh+", path=path, info=False)[-1].size
    # Mean cost per RHS call over the run (wtime_per_rhs of a single output
    # interval is dominated by the few calls in the last interval)
    wtime = collect("wtime_rhs", path=path, info=False)[1:].sum()
    ncalls = collect("ncalls", path=path, info=False)[1:].sum()
    stats[name] = (ncalls, wtime / ncalls, npoints)
    print(
        f"{name}: {ncalls:.0f} RHS evaluations, "
        f"{stats[name][1] * 1e3:.3f} ms per RHS, {npoints} points"
    )

s, u = stats["structured"], stats["unstructured"]
print(
    f"Ratios unstructured/structured: RHS evaluations {u[0] / s[0]:.2f}, "
    f"time per RHS and point {(u[1] / u[2]) / (s[1] / s[2]):.2f}"
)

success = u[0] <= 2.0 * s[0]
if success:
    print(" => Test passed")
    sys.exit(0)
print(" => Test failed: unstructured run needs more than 2x the solver work")
sys.exit(1)
