# Unstructured-mesh version of ../dommaschk-3D/BOUT.inp (same physics).
# Differences: the grid (create_grid.py), the precomputed XZ interpolation
# required on unstructured grids, the dirichlet_node boundary condition for
# the wall nodes. Both examples start from the same initial profile, in terms
# of the grid variable flux_label (0 on the inner, 1 on the outer flux
# surface; ../dommaschk_label.py), written by both create_grid.py scripts.

nout = 100
timestep = 10000

# Parallel heat conduction: petscoperator (support operators) is the default
# on unstructured grids and is set here explicitly. It conserves energy
# exactly, but on irregular meshes its solution error converges only at order
# 0.7-1.4 (MMS-spatial-fci-unstructured). Use conduction_method = original for
# second-order accuracy without exact energy conservation.
conduction_method = petscoperator

[mesh]

file = "dommaschk_unstructured_8_0.003.fci.nc"

[mesh:paralleltransform]
type = fci

[mesh:paralleltransform:xzinterpolation]
type = precomputed

[input:grid_variables]
flux_label = field3d

[solver]
mxstep = 10000
type = cvode
rtol = 1e-5
atol = 1e-10

[hermes]
# Note: collisions are needed to be able to calculate parallel conduction
components = (h+, e, braginskii_collisions, braginskii_conduction)

Nnorm = 1e19  # Reference density [m^-3]
Bnorm = 1   # Reference magnetic field [T]
Tnorm = 150   # Reference temperature [eV]

################################################################
# Ions

[h+]
type = fixed_density, evolve_pressure, anomalous_diffusion

AA = 1
charge = 1
anomalous_chi = 0.1
thermal_conduction = true
density = hermes:Nnorm

[Ph+]
function = 1.0 - 0.9 * gridvar:flux_label
bndry_xin = dirichlet_node(1.0)  # Inner flux surface (wall nodes)
bndry_xout = dirichlet_node(0.1)   # Outer flux surface (wall nodes)


[e]
type = fixed_density, evolve_pressure, anomalous_diffusion

AA = 1.0 / 1836.0
charge = -1
anomalous_chi = 0.1
thermal_conduction = true
density = hermes:Nnorm

[Pe]
function = 1.0 - 0.9 * gridvar:flux_label
bndry_xin = dirichlet_node(1.0)  # Inner flux surface (wall nodes)
bndry_xout = dirichlet_node(0.1)   # Outer flux surface (wall nodes)
